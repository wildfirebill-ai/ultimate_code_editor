{
  "name": "ultimate-editor",
  "version": "1.0.0",
  "author": "Ultimate Code Editor",
  "description": "The Ultimate Code Editor - combining the best features from VS Code, Zed, Continue.dev, Tabby, Roo Code, Aider, and Void IDE",
  "main": "dist/main/main.js",
  "scripts": {
    "start": "npm run build && electron .",
    "postinstall": "electron-builder install-app-deps",
    "dev": "concurrently -k \"vite\" \"cross-env VITE_DEV_SERVER_URL=http://localhost:5173 tsc -p tsconfig.main.json && electron .\"",
    "dev:renderer": "vite",
    "dev:electron": "tsc -p tsconfig.main.json && electron .",
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.main.json",
    "build": "npm run build:renderer && npm run build:main",
    "predist": "npm run build",
    "dist": "npx electron-builder",
    "predist:win": "npm run build",
    "dist:win": "npx electron-builder --win",
    "predist:mac": "npm run build",
    "dist:mac": "npx electron-builder --mac",
    "predist:linux": "npm run build",
    "dist:linux": "npx electron-builder --linux",
    "prepack": "npm run build",
    "pack": "npx electron-builder --dir"
  },
  "build": {
    "appId": "com.ultimate.editor",
    "productName": "Ultimate Editor",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.png",
      "artifactName": "UltimateEditor-${version}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "resources/icon.png",
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "resources/icon.png",
      "category": "Development"
    }
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "diff": "^9.0.0",
    "lucide-react": "^1.14.0",
    "monaco-editor": "^0.55.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "remark-gfm": "^4.0.0",
    "uuid": "^14.0.0",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0",
    "xterm-addon-web-links": "^0.9.0",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@types/diff": "^7.0.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "electron": "^42.0.1",
    "electron-builder": "^26.8.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.11"
  },
  "overrides": {
    "dompurify": "3.4.2"
  }
}
